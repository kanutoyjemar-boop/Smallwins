# PostgreSQL connection. Railway injects DATABASE_URL automatically when you
# attach a Postgres plugin to this service - you usually don't need to set
# this by hand in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/selfup

# Local development defaults to TLS disabled; production defaults to
# certificate-verified TLS for public database hosts. Loopback hosts and Railway's
# private network (*.railway.internal) are detected and need no setting.
# Set this explicitly only when your provider documents a different requirement.
# Optional PEM CA certificate:
# DATABASE_SSL_MODE=disable
# DATABASE_SSL_CA=

# Secret used to sign login tokens. Generate at least 32 random characters.
JWT_SECRET=

# Port the server listens on. Railway sets this for you automatically.
PORT=3000

# Web push (phone/browser notifications). Generate a pair with:
#   npm run vapid
# and paste the output here. Leave blank to run without notifications -
# the rest of the app works fine either way.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Trust the number of reverse-proxy hops in front of this app. Rate limiting
# depends on it. On Railway this defaults to 1 automatically; set it explicitly
# for any other proxy setup. Use 0 for direct local access.
TRUST_PROXY=0

# Sign-up is invite-only while this is set: new accounts need this code.
# Leave empty for open sign-up. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
SIGNUP_INVITE_CODE=

# Production only: sites allowed to call the API from a browser (comma-separated).
# The app's own pages need nothing here; without it, cross-origin access is closed.
# CORS_ORIGIN=https://yourapp.up.railway.app

# Password-reset email (optional). Without SMTP settings, account recovery
# remains disabled and the app continues to work normally.
APP_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
