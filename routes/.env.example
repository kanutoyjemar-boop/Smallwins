# PostgreSQL connection. Railway injects DATABASE_URL automatically when you
# attach a Postgres plugin to this service - you usually don't need to set
# this by hand in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/selfup

# Secret used to sign login tokens. Set a long random string in Railway.
JWT_SECRET=change-this-to-something-long-and-random

# Port the server listens on. Railway sets this for you automatically.
PORT=3000

# Web push (phone/browser notifications). Generate a pair with:
#   npm run vapid
# and paste the output here. Leave blank to run without notifications -
# the rest of the app works fine either way.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
